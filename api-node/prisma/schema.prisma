generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Visitante {
  id            Int    @id @default(autoincrement())
  nome          String
  idade         Int
  areaInteresse String @map("area_interesse")

  @@map("visitantes")
}
